# Optional first-boot seeds only. Prefer leaving both unset for random keys.
# Each must be a DIFFERENT random string of >=32 characters.
# Once data/auth.json exists, it is authoritative across restarts/rotation.
# MUSE2API_KEY=
# MUSE2API_ADMIN_KEY=
MUSE2API_HOST=127.0.0.1
MUSE2API_PORT=18610
MUSE2API_PUBLIC_BASE=
MUSE2API_CORS_ORIGINS=
MUSE2API_CHROMIUM=/usr/bin/chromium
